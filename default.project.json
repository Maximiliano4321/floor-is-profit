{
  "name": "Floor is Profit",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "AutoJumpEnabled": false,
        "CameraMaxZoomDistance": 120,
        "CameraMinZoomDistance": 8,
        "CharacterJumpHeight": 13,
        "CharacterUseJumpPower": false,
        "CharacterWalkSpeed": 18,
        "EnableMouseLockOption": true
